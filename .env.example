APP_URL=http://localhost:3000
API_URL=http://localhost:4000
NODE_ENV=development

# Demo mode cho web dashboard: khi =true, dashboard mô phỏng lượt xem/đơn hàng/doanh thu
# để demo. Mặc định (không set hoặc khác true): TẮT — không sinh số liệu giả.
NEXT_PUBLIC_DEMO_MODE=false

# Database — BẮT BUỘC dùng Postgres có extension pgvector (cho RAG embeddings).
# Local: image pgvector/pgvector:pg16 (xem infra/docker/docker-compose.yml).
# Cloud: Neon / Supabase (bật extension "vector" trong dashboard).
DATABASE_URL=postgresql://orh:orh_password@localhost:5432/openremotehub

# Redis
REDIS_URL=redis://localhost:6379

# Frontend gọi API qua URL này (khi deploy Vercel: set bằng URL public của backend)
NEXT_PUBLIC_API_URL=http://localhost:4000

# Session & Crypto  (replace with secret manager in production)
SESSION_SECRET=replace-with-at-least-32-random-chars
# 32-byte hex — mã hóa API key AI + OAuth token (AES-256-GCM).
# MẤT KEY NÀY = không giải mã được key đã lưu. Backup an toàn!
TOKEN_ENCRYPTION_KEY=replace-with-32-byte-hex-from-kms

# Google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Meta (Facebook + Instagram)
META_APP_ID=
META_APP_SECRET=

# TikTok
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# GitHub (optional)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Object Storage (e.g. S3-compatible)
OBJECT_STORAGE_BUCKET=
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_ACCESS_KEY=
OBJECT_STORAGE_SECRET_KEY=

# Email (for notifications)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@example.com

# Database trực tiếp (không qua pooler) — Prisma dùng khi migrate.
# BẮT BUỘC nếu deploy Railway/Neon (schema.prisma: directUrl).
DIRECT_DATABASE_URL=postgresql://orh:orh_password@localhost:5432/openremotehub

# API key server-to-server (header X-API-Key), phân cách bằng dấu phẩy.
# Dùng cho worker/service nội bộ gọi API. Không set = tắt auth này.
INTEGRATION_API_KEYS=

# Webhook Make.com — gọi sau mỗi lần publish xong (kèm chữ ký HMAC-SHA256).
MAKE_WEBHOOK_URL=
MAKE_WEBHOOK_SECRET=

# ImgBB — host ảnh (Canva export, upload ảnh content). Lấy key miễn phí tại api.imgbb.com
IMGBB_API_KEY=

# Cloudinary — upload video content
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# TikTok Direct Post: SELF_ONLY (mặc định — app chưa qua audit TikTok, video ở chế độ riêng tư)
# hoặc PUBLIC_TO_EVERYONE (CHỈ đặt sau khi TikTok duyệt app)
TIKTOK_PRIVACY_LEVEL=SELF_ONLY

# Instagram Login — app ID/secret RIÊNG, không dùng chung với Facebook
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=

# Publish worker chạy trong API: true (mặc định) | false (tắt hẳn)
PUBLISH_WORKER_ENABLED=true
# Chu kỳ poll job publish, ms (mặc định 15000)
PUBLISH_POLL_MS=15000
# Số job xử lý mỗi tick (mặc định 5)
PUBLISH_BATCH_SIZE=5

# Concat video renderer (mặc định TẮT). Bật khi đã cài concat-cli (xem docs/concat-render.md)
CONCAT_ENABLED=false
# Đường dẫn binary concat-cli (Docker image đã set sẵn /usr/local/bin/concat-cli)
CONCAT_CLI_PATH=concat-cli
# true: API tự spawn "concat-cli serve" lúc boot | false: nối tới serve đang chạy sẵn
CONCAT_AUTOSTART=true

# Ghi đè SameSite cho session cookie. Mặc định: lax (dev), none (production, bắt buộc kèm Secure).
# Chỉ set 'lax' ở production khi frontend và backend cùng domain.
SESSION_SAMESITE=

# Pepper cho hash email/IP (HMAC-SHA256) — BẮT BUỘC ở production, thiếu là API từ chối boot (fail-closed).
# Tạo bằng: openssl rand -hex 32. KHÔNG xoay pepper trên DB đang chạy nếu chưa có migration riêng.
HASH_PEPPER=

# Key mã hóa cũ — dùng khi xoay TOKEN_ENCRYPTION_KEY: decrypt() tự fallback sang key này.
# Quy trình 4 bước an toàn: docs/key-rotation.md. Để trống khi không xoay key.
TOKEN_ENCRYPTION_KEY_PREVIOUS=
