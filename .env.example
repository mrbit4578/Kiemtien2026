APP_URL=http://localhost:3000
API_URL=http://localhost:4000
NODE_ENV=development

# Demo mode cho web dashboard: khi =true, dashboard mô phỏng lượt xem/đơn hàng/doanh thu
# để demo. Mặc định (không set hoặc khác true): TẮT — không sinh số liệu giả.
NEXT_PUBLIC_DEMO_MODE=false

# Database — BẮT BUỘC dùng Postgres có extension pgvector (cho RAG embeddings).
# Local: image pgvector/pgvector:pg16 (xem infra/docker/docker-compose.yml).
# Cloud: Neon / Supabase (bật extension "vector" trong dashboard).
DATABASE_URL=postgresql://orh:orh_password@localhost:5432/openremotehub

# Redis
REDIS_URL=redis://localhost:6379

# Frontend gọi API qua URL này (khi deploy Vercel: set bằng URL public của backend)
NEXT_PUBLIC_API_URL=http://localhost:4000

# Session & Crypto  (replace with secret manager in production)
SESSION_SECRET=replace-with-at-least-32-random-chars
# 32-byte hex — mã hóa API key AI + OAuth token (AES-256-GCM).
# MẤT KEY NÀY = không giải mã được key đã lưu. Backup an toàn!
TOKEN_ENCRYPTION_KEY=replace-with-32-byte-hex-from-kms

# Google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Meta (Facebook + Instagram)
META_APP_ID=
META_APP_SECRET=

# TikTok
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# GitHub (optional)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Object Storage (e.g. S3-compatible)
OBJECT_STORAGE_BUCKET=
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_ACCESS_KEY=
OBJECT_STORAGE_SECRET_KEY=

# Email (for notifications)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@example.com
