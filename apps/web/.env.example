# ─── OpenRemoteHub Web (apps/web) ─────────────────────────────
# Copy file này thành `.env.local` và điền giá trị thật. Không commit `.env.local`.

# URL public của backend NestJS API.
# - Local dev: backend chạy ở http://localhost:4000 (API_PORT=4000)
# - Deploy: điền domain thật, VD: https://api.openremotehub.com
# Frontend gọi API qua URL này với credentials: 'include' (session cookie).
NEXT_PUBLIC_API_URL=http://localhost:4000

# DEMO MODE: khi =true, dashboard bật các luồng giả lập
# (tự cộng doanh thu, auto-inject nội dung Session #1) để demo offline.
# Mặc định TẮT — dashboard chỉ hiển thị dữ liệu thật từ API hoặc dữ liệu local.
NEXT_PUBLIC_DEMO_MODE=false
