{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "buildCommand": "pnpm install && pnpm --filter @orh/api build"
  },
  "deploy": {
    // Migrate DB (idempotent) rồi mới start server.
    "startCommand": "pnpm --filter @orh/api exec prisma migrate deploy --schema prisma/schema.prisma && pnpm --filter @orh/api start",
    "healthcheckPath": "/rag/strategies",
    "healthcheckTimeout": 300,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10
  }
}
